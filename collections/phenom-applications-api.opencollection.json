{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phenom Talent Experience Platform Applicants Applications API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-qa.phenompro.com/apply/v2/applications",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch a list of applications (candidate + job data)."
        }
      ]
    }
  ],
  "bundled": true
}